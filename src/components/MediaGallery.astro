---
export interface MediaItem {
	type: "photo" | "clip";
	src?: string;
	streamId?: string;
	alt?: string;
	classes?: string[];
}

interface Props {
	items: MediaItem[];
	// Used to build the order mailto subject: "Order inquiry: {orderLabel}"
	orderLabel: string;
}

const { items, orderLabel } = Astro.props;
const CONTACT_EMAIL = "hello@osw.media";
const orderSubject = encodeURIComponent(`Order inquiry: ${orderLabel}`);
const photoCount = items.filter((item) => item.type === "photo").length;
const clipCount = items.filter((item) => item.type === "clip").length;
---

<div class="toolbar">
	<div class="filters" role="group" aria-label="Filter gallery">
		<button type="button" class="pill" data-filter-btn="all" aria-pressed="true">
			All ({items.length})
		</button>
		<button type="button" class="pill" data-filter-btn="photo" aria-pressed="false">
			Photos ({photoCount})
		</button>
		<button type="button" class="pill" data-filter-btn="clip" aria-pressed="false">
			Video Clips ({clipCount})
		</button>
	</div>
	<a class="btn btn-primary" href={`mailto:${CONTACT_EMAIL}?subject=${orderSubject}`}>
		Contact me
	</a>
</div>

<div class="gallery">
	{
		items.map((item, index) => {
			const label = item.type === "photo" ? `Photo ${index + 1}` : `Video Clip ${index + 1}`;
			return (
				<div class="tile" data-item={item.type}>
					<button
						type="button"
						class="tile-trigger"
						data-lightbox-trigger
						data-type={item.type}
						data-label={label}
						aria-label={`View ${label}`}
					>
						{item.type === "photo" ? (
							<div class="placeholder placeholder-photo">
								<span class="placeholder-label">{label}</span>
							</div>
						) : (
							<div class="placeholder placeholder-clip">
								<span class="play-icon" aria-hidden="true" />
								<span class="placeholder-label">{label}</span>
							</div>
						)}
					</button>
				</div>
			);
		})
	}
</div>

<div class="lightbox" id="lightbox" hidden>
	<div class="lightbox-backdrop" data-lightbox-close />
	<div class="lightbox-panel" role="dialog" aria-modal="true" aria-label="Media preview">
		<button type="button" class="lightbox-close" data-lightbox-close aria-label="Close">
			&times;
		</button>

		<div class="lightbox-content">
			<div class="lightbox-media-wrap">
				<div class="placeholder lightbox-media" id="lightbox-media" />
				<button type="button" class="lightbox-nav lightbox-prev" data-lightbox-prev aria-label="Previous item">
					<span class="chevron chevron-left" aria-hidden="true" />
				</button>
				<button type="button" class="lightbox-nav lightbox-next" data-lightbox-next aria-label="Next item">
					<span class="chevron chevron-right" aria-hidden="true" />
				</button>
			</div>
			<p class="lightbox-label" id="lightbox-label" />
		</div>

		<div class="lightbox-footer">
			<a class="btn btn-primary" href={`mailto:${CONTACT_EMAIL}?subject=${orderSubject}`}>
				Contact me
			</a>
		</div>
	</div>
</div>

<script>
	const filterButtons = document.querySelectorAll<HTMLButtonElement>("[data-filter-btn]");
	const tiles = document.querySelectorAll<HTMLElement>("[data-item]");

	for (const button of filterButtons) {
		button.addEventListener("click", () => {
			const filter = button.dataset.filterBtn;

			for (const b of filterButtons) {
				b.setAttribute("aria-pressed", String(b === button));
			}

			for (const tile of tiles) {
				tile.hidden = filter !== "all" && tile.dataset.item !== filter;
			}
		});
	}

	// Lightbox: opens on any tile click, keeps the order button on-screen
	// alongside whatever media is being viewed, and steps through the
	// currently-filtered set of tiles (not the whole gallery).
	const lightbox = document.getElementById("lightbox") as HTMLDivElement;
	const lightboxMedia = document.getElementById("lightbox-media") as HTMLDivElement;
	const lightboxLabel = document.getElementById("lightbox-label") as HTMLParagraphElement;
	let lastFocused: HTMLElement | null = null;
	let currentIndex = 0;

	function visibleTriggers() {
		return Array.from(
			document.querySelectorAll<HTMLButtonElement>(
				"[data-item]:not([hidden]) [data-lightbox-trigger]",
			),
		);
	}

	function renderAt(index: number) {
		const triggers = visibleTriggers();
		if (triggers.length === 0) return;
		currentIndex = (index + triggers.length) % triggers.length;
		const trigger = triggers[currentIndex];
		const type = trigger.dataset.type;
		const label = trigger.dataset.label ?? "";

		lightboxMedia.className = `placeholder lightbox-media placeholder-${type}`;
		lightboxMedia.innerHTML =
			type === "clip" ? '<span class="play-icon" aria-hidden="true"></span>' : "";
		lightboxLabel.textContent = label;
	}

	function openLightbox(index: number) {
		lastFocused = document.activeElement as HTMLElement;
		renderAt(index);
		lightbox.hidden = false;
		document.body.style.overflow = "hidden";
		(lightbox.querySelector(".lightbox-close") as HTMLButtonElement)?.focus();
	}

	function closeLightbox() {
		lightbox.hidden = true;
		document.body.style.overflow = "";
		lastFocused?.focus();
	}

	for (const trigger of document.querySelectorAll<HTMLButtonElement>("[data-lightbox-trigger]")) {
		trigger.addEventListener("click", () => {
			const triggers = visibleTriggers();
			openLightbox(triggers.indexOf(trigger));
		});
	}

	for (const el of document.querySelectorAll("[data-lightbox-close]")) {
		el.addEventListener("click", closeLightbox);
	}

	document.querySelector("[data-lightbox-prev]")?.addEventListener("click", () => renderAt(currentIndex - 1));
	document.querySelector("[data-lightbox-next]")?.addEventListener("click", () => renderAt(currentIndex + 1));

	document.addEventListener("keydown", (event) => {
		if (lightbox.hidden) return;
		if (event.key === "Escape") closeLightbox();
		if (event.key === "ArrowLeft") renderAt(currentIndex - 1);
		if (event.key === "ArrowRight") renderAt(currentIndex + 1);
	});
</script>

<style>
	.toolbar {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-2);
		margin-block: var(--space-3) var(--space-4);
		padding-block: var(--space-2);
		border-block: 1px solid var(--color-border);
	}

	.filters {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
	}

	.pill {
		font-family: var(--font-body);
		font-weight: 600;
		font-size: 0.875rem;
		color: var(--color-text-muted);
		background: transparent;
		border: 1px solid var(--color-border);
		border-radius: 999px;
		padding: 0.5rem 1.125rem;
		cursor: pointer;
	}

	.pill:hover {
		border-color: var(--color-text-muted);
		color: var(--color-text);
	}

	.pill[aria-pressed="true"] {
		background: var(--color-accent);
		border-color: var(--color-accent);
		color: var(--color-accent-contrast);
	}

	.gallery {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(16rem, 1fr));
		gap: var(--space-2);
	}

	.tile {
		aspect-ratio: 4 / 3;
	}

	.tile-trigger {
		display: block;
		width: 100%;
		height: 100%;
		padding: 0;
		border: 0;
		background: none;
		cursor: pointer;
	}

	.tile-trigger:hover .placeholder,
	.tile-trigger:focus-visible .placeholder {
		border-color: var(--color-accent);
	}

	.placeholder {
		width: 100%;
		height: 100%;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 0.5rem;
		background:
			repeating-linear-gradient(
				135deg,
				var(--color-bg) 0 12px,
				var(--color-bg-raised) 12px 24px
			);
		border: 1px solid var(--color-border);
		border-radius: 4px;
	}

	.placeholder-label {
		font-size: 0.8125rem;
		color: var(--color-text-muted);
	}

	/* :global — the lightbox injects a play-icon span via innerHTML, which
	   doesn't carry Astro's scoping attribute, so this must match globally. */
	:global(.play-icon) {
		width: 0;
		height: 0;
		border-style: solid;
		border-width: 0.55rem 0 0.55rem 0.9rem;
		border-color: transparent transparent transparent var(--color-text-muted);
	}

	/* 3x the gallery-tile play icon — the lightbox media box is much
	   bigger, so the same icon size read as too small there. */
	:global(.lightbox-media .play-icon) {
		border-width: 1.65rem 0 1.65rem 2.7rem;
	}

	/* Lightbox */

	.lightbox {
		position: fixed;
		inset: 0;
		z-index: 10;
		display: flex;
		align-items: center;
		justify-content: center;
		padding: var(--space-3);
	}

	/* Higher specificity than .lightbox so the hidden attribute actually
	   hides it — author display:flex above would otherwise beat the
	   browser's default [hidden]{display:none} UA rule. */
	.lightbox[hidden] {
		display: none;
	}

	.lightbox-backdrop {
		position: absolute;
		inset: 0;
		background: rgba(0, 0, 0, 0.8);
	}

	.lightbox-panel {
		position: relative;
		z-index: 1;
		display: flex;
		flex-direction: column;
		gap: var(--space-3);
		width: min(100%, 53rem);
		max-height: 90vh;
		padding: var(--space-3);
		background: var(--color-bg-raised);
		border: 1px solid var(--color-border);
		border-radius: 4px;
	}

	.lightbox-content {
		display: flex;
		flex-direction: column;
		gap: var(--space-2);
	}

	.lightbox-media-wrap {
		position: relative;
	}

	.lightbox-media {
		aspect-ratio: 4 / 3;
	}

	.lightbox-label {
		text-align: center;
		color: var(--color-text-muted);
		margin-bottom: 0;
	}

	.lightbox-footer {
		display: flex;
		justify-content: center;
	}

	.lightbox-close {
		position: absolute;
		top: -0.75rem;
		right: -0.75rem;
		width: 2.25rem;
		height: 2.25rem;
		display: flex;
		align-items: center;
		justify-content: center;
		font-size: 1.5rem;
		line-height: 1;
		color: var(--color-text);
		background: var(--color-bg);
		border: 1px solid var(--color-border);
		border-radius: 999px;
		cursor: pointer;
	}

	.lightbox-close:hover {
		border-color: var(--color-accent);
	}

	.lightbox-nav {
		position: absolute;
		top: 50%;
		translate: 0 -50%;
		width: 2.5rem;
		height: 2.5rem;
		display: flex;
		align-items: center;
		justify-content: center;
		color: var(--color-text);
		background: var(--color-bg);
		border: 1px solid var(--color-border);
		border-radius: 999px;
		cursor: pointer;
	}

	.lightbox-nav:hover {
		border-color: var(--color-accent);
	}

	.lightbox-prev {
		left: -1.25rem;
	}

	.lightbox-next {
		right: -1.25rem;
	}

	/* Hand-drawn chevrons instead of the lsaquo/rsaquo glyphs — those
	   render with an off-center visual weight in most fonts. */
	.chevron {
		width: 0.6rem;
		height: 0.6rem;
		border-style: solid;
		border-width: 0 0.15rem 0.15rem 0;
		border-color: var(--color-text);
	}

	.chevron-right {
		transform: translateX(-15%) rotate(-45deg);
	}

	.chevron-left {
		transform: translateX(15%) rotate(135deg);
	}

	@media (max-width: 640px) {
		.lightbox-prev {
			left: 0;
		}

		.lightbox-next {
			right: 0;
		}
	}
</style>
