---
import "../styles/global.css";
import { getRelativeLocaleUrl } from "astro:i18n";
import { languages, defaultLang } from "../i18n/ui";

const flags: Record<keyof typeof languages, string> = {
	en: "\u{1F1EC}\u{1F1E7}",
	nl: "\u{1F1F3}\u{1F1F1}",
};
import { useTranslations } from "../i18n/utils";

interface Props {
	title: string;
}

const { title } = Astro.props;
const CONTACT_EMAIL = "hello@osw.media";

const lang = Astro.currentLocale ?? defaultLang;
const t = useTranslations(lang);

// Same page, other language — strip a leading "/nl" if present so both
// links can be built from the same locale-less pathname.
const pathname = Astro.url.pathname.replace(/^\/nl(\/|$)/, "/");
const langHrefs = {
	en: pathname,
	nl: getRelativeLocaleUrl("nl", pathname),
};
---

<html lang={lang}>
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/png" href="/brand/icon.png" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>{title} | OSW's Photo Video</title>
	</head>
	<body>
		<header class="site-header">
			<nav class="wrap">
				<a class="brand" href={langHrefs[lang]}>
					<img src="/brand/horizontal-logo.png" alt="OSW's Photo Video" />
				</a>
				<a href={getRelativeLocaleUrl(lang, "/portfolio")}>{t("nav.portfolio")}</a>
				<a href={getRelativeLocaleUrl(lang, "/albums")}>{t("nav.albums")}</a>
				<a href={`mailto:${CONTACT_EMAIL}`}>{t("nav.contact")}</a>
				<div class="lang-switch" role="group" aria-label="Language">
					{
						(Object.keys(languages) as (keyof typeof languages)[]).map((code) => (
							<a
								href={langHrefs[code]}
								class="lang-btn"
								aria-current={lang === code ? "true" : undefined}
								aria-label={languages[code]}
								title={languages[code]}
							>
								{flags[code]}
							</a>
						))
					}
				</div>
			</nav>
		</header>

		<main>
			<slot />
		</main>

		<footer class="site-footer">
			<p class="wrap">&copy; {new Date().getFullYear()} {t("footer.text")}</p>
		</footer>
	</body>
</html>

<style>
	.lang-switch {
		display: flex;
		gap: 0.375rem;
	}

	.lang-btn {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 1.75rem;
		height: 1.75rem;
		font-size: 1rem;
		line-height: 1;
		text-decoration: none;
		border: 1px solid transparent;
		border-radius: 999px;
		opacity: 0.5;
		filter: grayscale(60%);
		transition: opacity 0.15s ease, filter 0.15s ease, border-color 0.15s ease;
	}

	.lang-btn:hover {
		opacity: 0.85;
		filter: grayscale(0%);
	}

	.lang-btn[aria-current="true"] {
		opacity: 1;
		filter: grayscale(0%);
		border-color: var(--color-accent);
	}
</style>
