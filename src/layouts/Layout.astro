---
import "../styles/global.css";

interface Props {
	title: string;
}

const { title } = Astro.props;
const CONTACT_EMAIL = "hello@osw.media";
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/png" href="/brand/icon.png" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>{title} | OSW's Photo Video</title>
	</head>
	<body>
		<header class="site-header">
			<nav class="wrap">
				<a class="brand" href="/">
					<img src="/brand/horizontal-logo.png" alt="OSW's Photo Video" />
				</a>
				<a href="/albums">Albums</a>
				<a class="btn btn-outline" href={`mailto:${CONTACT_EMAIL}`}>Contact</a>
			</nav>
		</header>

		<main>
			<slot />
		</main>

		<footer class="site-footer">
			<p class="wrap">&copy; {new Date().getFullYear()} OSW's Photo Video</p>
		</footer>
	</body>
</html>
