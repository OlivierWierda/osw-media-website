---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";

const albums = await getCollection("albums");
albums.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const dateFormatter = new Intl.DateTimeFormat("en-GB", {
	day: "numeric",
	month: "short",
	year: "numeric",
});

function counts(items: (typeof albums)[number]["data"]["items"]) {
	const photos = items.filter((item) => item.type === "photo").length;
	const clips = items.filter((item) => item.type === "clip").length;
	return { photos, clips };
}
---

<Layout title="Albums">
	<section class="albums">
		<div class="wrap">
			<h1>Albums</h1>
			<p class="intro">One album per event, or per day for multi-day events.</p>

			<div class="grid">
				{
					albums.map((album) => {
						const { photos, clips } = counts(album.data.items);
						return (
							<a class="card" href={`/albums/${album.id}`}>
								<div class="card-thumb" aria-hidden="true">
									<span>{album.data.items.length}</span>
								</div>
								<div class="card-body">
									<p class="card-date">{dateFormatter.format(album.data.date)}</p>
									<h2>{album.data.title}</h2>
									{album.data.venue && <p class="card-venue">{album.data.venue}</p>}
									<p class="card-counts">
										{photos} photo{photos === 1 ? "" : "s"} · {clips} clip{clips === 1 ? "" : "s"}
									</p>
								</div>
							</a>
						);
					})
				}
			</div>
		</div>
	</section>
</Layout>

<style>
	.albums {
		padding-block: var(--space-4) var(--space-5);
	}

	.intro {
		color: var(--color-text-muted);
		margin-top: calc(var(--space-2) * -1 + 0.25rem);
		margin-bottom: var(--space-4);
	}

	.grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(18rem, 1fr));
		gap: var(--space-3);
	}

	.card {
		display: flex;
		flex-direction: column;
		text-decoration: none;
		color: inherit;
		background: var(--color-bg-raised);
		border: 1px solid var(--color-border);
		border-radius: 4px;
		overflow: hidden;
		transition: border-color 0.15s ease;
	}

	.card:hover {
		border-color: var(--color-accent);
	}

	.card-thumb {
		aspect-ratio: 16 / 10;
		display: flex;
		align-items: center;
		justify-content: center;
		background:
			repeating-linear-gradient(
				135deg,
				var(--color-bg) 0 12px,
				var(--color-bg-raised) 12px 24px
			);
		border-bottom: 1px solid var(--color-border);
	}

	.card-thumb span {
		font-family: var(--font-display);
		font-size: 1.75rem;
		color: var(--color-text-muted);
	}

	.card-body {
		padding: var(--space-2) var(--space-3) var(--space-3);
	}

	.card-date {
		font-size: 0.8125rem;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		color: var(--color-accent);
		margin-bottom: 0.25rem;
	}

	.card h2 {
		font-size: 1.375rem;
		margin-bottom: 0.25rem;
	}

	.card-venue {
		color: var(--color-text-muted);
		margin-bottom: 0.5rem;
	}

	.card-counts {
		font-size: 0.875rem;
		color: var(--color-text-muted);
		margin-bottom: 0;
	}
</style>
