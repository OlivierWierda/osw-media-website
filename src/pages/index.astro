---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import heroCover from "../assets/brand/hero-cover.png";
import portraitCutout from "../assets/brand/portrait-cutout.png";

const CONTACT_EMAIL = "hello@osw.media";
---

<Layout title="Home">
	<section class="hero">
		<div class="hero-bg">
			<Image src={heroCover} alt="" width={2400} quality={70} />
			<div class="hero-bg-overlay"></div>
		</div>
		<div class="wrap hero-content">
			<p class="eyebrow">A-to-Z Motorsport Media Production &amp; Content Creation</p>
			<h1>A different perspective, trackside.</h1>
			<p class="lede">
				With a 30-year+ fascination for cars, and specifically motorsport,
				sim and RC racing, as a participant, fan, and coach, I am in a
				unique position to make the sport more accessible and appealing.
			</p>
			<div class="cta-row">
				<a class="btn btn-primary" href={`mailto:${CONTACT_EMAIL}`}>Contact</a>
				<a class="btn btn-outline" href="/albums">View albums</a>
			</div>
		</div>
	</section>

	<section class="about">
		<div class="wrap">
			<p class="subhead">About</p>
			<div class="about-copy">
				<p>
					As an avid simracer, I look at the track with a mixed
					perspective, as a driver, as an engineer, as a coach, and as a
					passionate fan.
				</p>
				<p>But real motorsport is not just seen or heard, it is an energy you can feel.</p>
				<p>
					The vision to share this with others, morphed into OSW's Photo
					Video, where I focus on bringing the atmosphere of the track, the
					cars, and the paddock to life.
				</p>
				<p>Capturing and sharing the passion, that's the goal.</p>
			</div>
		</div>
		<div class="about-portrait">
			<Image src={portraitCutout} alt="OSW behind the camera, trackside" width={1358} quality={80} />
		</div>
	</section>
</Layout>

<style>
	.hero {
		position: relative;
		overflow: hidden;
		padding-block: var(--space-5) var(--space-4);
		border-bottom: 1px solid var(--color-border);
	}

	.hero-bg {
		position: absolute;
		inset: 0;
		z-index: 0;
	}

	.hero-bg :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.hero-bg-overlay {
		position: absolute;
		inset: 0;
		background: linear-gradient(
			180deg,
			rgba(32, 34, 38, 0.75) 0%,
			rgba(32, 34, 38, 0.88) 55%,
			rgba(32, 34, 38, 0.97) 100%
		);
	}

	.hero-content {
		position: relative;
		z-index: 1;
	}

	.eyebrow {
		font-family: var(--font-body);
		font-weight: 600;
		font-size: 0.8125rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--color-accent);
		margin-bottom: var(--space-2);
	}

	.hero h1 {
		font-size: clamp(2.5rem, 6vw, 4.5rem);
		max-width: 16ch;
	}

	.lede {
		max-width: 48ch;
		font-size: 1.0625rem;
		color: var(--color-text-muted);
		margin-top: var(--space-2);
	}

	.cta-row {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-2);
		margin-top: var(--space-3);
	}

	.about {
		position: relative;
		padding-block: var(--space-4);
	}

	.about .subhead {
		font-family: var(--font-subhead);
		font-size: 1.5rem;
		color: var(--color-text);
	}

	.about-copy {
		/* Narrowed from 60ch so the column clears the (now much bigger)
		   portrait's footprint instead of running text under it. */
		max-width: 34ch;
		color: var(--color-text-muted);
	}

	.about-copy p:last-child {
		margin-bottom: 0;
	}

	/* Deliberately breaks the grid: positioned to straddle the
	   hero/about seam rather than sit politely inside either section. */
	.about-portrait {
		position: absolute;
		top: -440px;
		right: max(var(--space-3), calc((100% - var(--content-max)) / 2 + var(--space-3)));
		width: min(60vw, 840px);
		z-index: 2;
		pointer-events: none;
	}

	.about-portrait :global(img) {
		width: 100%;
		height: auto;
		display: block;
		filter: grayscale(0.1) drop-shadow(0 30px 40px rgba(0, 0, 0, 0.45));
	}

	@media (max-width: 900px) {
		.about-portrait {
			width: min(76vw, 600px);
			top: -280px;
		}
	}

	@media (max-width: 640px) {
		.about-portrait {
			display: none;
		}
	}
</style>
